---
const { item } = Astro.props;
---

<article class="portfolio-card">
  <a href={`/${item.slug}`} aria-label={`Lihat detail ${item.title}`}>
    <img src={item.cover} alt={`Foto ${item.title}`} loading="lazy" />
    <div>
      <p class="eyebrow">{item.category}</p>
      <h3>{item.title}</h3>
      <p>{item.excerpt}</p>
      <span>{item.location}</span>
    </div>
  </a>
</article>
