---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import CardPortofolio from "../components/CardPortofolio.astro";

type MarkdownModule<T extends Record<string, unknown>> = {
  frontmatter: T;
};

type PortfolioFrontmatter = {
  title: string;
  date: string;
  location: string;
  category: string;
  cover: string;
  excerpt: string;
};

type PaketFrontmatter = {
  title: string;
  price: string;
  featured: boolean;
  description: string;
  features: string[];
};

type TestimoniFrontmatter = {
  title: string;
  date: string;
  image?: string;
  rating: number;
  quote: string;
};

const getSlugFromPath = (path: string) => {
  const filename = path.split("/").pop() ?? "";
  return filename.replace(".md", "");
};

const portfolioModules = import.meta.glob<MarkdownModule<PortfolioFrontmatter>>("../content/portofolio/*.md", { eager: true });
const paketModules = import.meta.glob<MarkdownModule<PaketFrontmatter>>("../content/paket/*.md", { eager: true });
const testimoniModules = import.meta.glob<MarkdownModule<TestimoniFrontmatter>>("../content/testimoni/*.md", { eager: true });

const toEntry = <T extends Record<string, unknown>>([path, module]: [string, MarkdownModule<T>]) => ({
  slug: getSlugFromPath(path),
  ...module.frontmatter,
});

const portfolios = Object.entries(portfolioModules).map(toEntry).slice(0, 3);
const packages = Object.entries(paketModules).map(toEntry);
const testimonials = Object.entries(testimoniModules).map(toEntry);
---

<BaseLayout>
  <Hero />

  <section class="px-[clamp(20px,5vw,72px)] py-[clamp(52px,8vw,96px)]">
    <div class="mb-7 max-w-[760px]">
      <p class="mb-2.5 text-xs font-extrabold uppercase text-coral">Layanan</p>
      <h2 class="text-[clamp(1.8rem,3.4vw,3.4rem)] leading-[1.08]">Paket yang bisa disesuaikan dengan kebutuhan acara.</h2>
    </div>
    <div class="grid grid-cols-1 gap-[22px] min-[860px]:grid-cols-3">
      {packages.map((paket) => (
        <article class:list={["overflow-hidden rounded-lg border border-forest/10 bg-white p-[22px] shadow-soft", paket.featured && "border-coral/45"]}>
          <p class="mb-2.5 text-xs font-extrabold uppercase text-coral">{paket.featured ? "Favorit" : "Paket"}</p>
          <h3 class="mb-3 text-[1.35rem] font-extrabold leading-tight">{paket.title}</h3>
          <strong class="mb-3 block text-[1.2rem] text-forest">{paket.price}</strong>
          <p class="leading-[1.7] text-muted">{paket.description}</p>
          <a class="font-extrabold text-coral" href={`/${paket.slug}`}>Lihat detail</a>
        </article>
      ))}
    </div>
  </section>

  <section class="bg-[#edf1e2] px-[clamp(20px,5vw,72px)] py-[clamp(52px,8vw,96px)]">
    <div class="mb-7 max-w-[760px]">
      <p class="mb-2.5 text-xs font-extrabold uppercase text-coral">Portofolio</p>
      <h2 class="text-[clamp(1.8rem,3.4vw,3.4rem)] leading-[1.08]">Momen yang sudah kami bantu wujudkan.</h2>
    </div>
    <div class="grid grid-cols-1 gap-[22px] min-[860px]:grid-cols-3">
      {portfolios.map((item) => <CardPortofolio item={item} />)}
    </div>
  </section>

  <section class="px-[clamp(20px,5vw,72px)] py-[clamp(52px,8vw,96px)]">
    <div class="mb-7 max-w-[760px]">
      <p class="mb-2.5 text-xs font-extrabold uppercase text-coral">Testimoni</p>
      <h2 class="text-[clamp(1.8rem,3.4vw,3.4rem)] leading-[1.08]">Kata pasangan yang pernah bekerja bersama kami.</h2>
    </div>
    <div class="grid grid-cols-1 gap-[22px] min-[860px]:grid-cols-3">
      {testimonials.map((item) => (
        <figure class="m-0 overflow-hidden rounded-lg border border-forest/10 bg-white p-[22px] shadow-soft">
          <blockquote class="mb-[18px] leading-[1.7] text-muted">{item.quote}</blockquote>
          <figcaption class="font-extrabold text-forest">{item.title}</figcaption>
        </figure>
      ))}
    </div>
  </section>
</BaseLayout>
