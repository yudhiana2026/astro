---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import CardPortofolio from "../components/CardPortofolio.astro";

type MarkdownModule<T extends Record<string, unknown>> = {
  frontmatter: T;
};

type PortfolioFrontmatter = {
  title: string;
  date: string;
  location: string;
  category: string;
  cover: string;
  excerpt: string;
};

type PaketFrontmatter = {
  title: string;
  price: string;
  featured: boolean;
  description: string;
  features: string[];
};

type TestimoniFrontmatter = {
  title: string;
  date: string;
  image?: string;
  rating: number;
  quote: string;
};

const getSlugFromPath = (path: string) => {
  const filename = path.split("/").pop() ?? "";
  return filename.replace(".md", "");
};

const portfolioModules = import.meta.glob<MarkdownModule<PortfolioFrontmatter>>("../content/portofolio/*.md", { eager: true });
const paketModules = import.meta.glob<MarkdownModule<PaketFrontmatter>>("../content/paket/*.md", { eager: true });
const testimoniModules = import.meta.glob<MarkdownModule<TestimoniFrontmatter>>("../content/testimoni/*.md", { eager: true });

const toEntry = <T extends Record<string, unknown>>([path, module]: [string, MarkdownModule<T>]) => ({
  slug: getSlugFromPath(path),
  ...module.frontmatter,
});

const portfolios = Object.entries(portfolioModules).map(toEntry).slice(0, 3);
const packages = Object.entries(paketModules).map(toEntry);
const testimonials = Object.entries(testimoniModules).map(toEntry);
---

<BaseLayout>
  <Hero />

  <section class="section">
    <div class="section-heading">
      <p class="eyebrow">Layanan</p>
      <h2>Paket yang bisa disesuaikan dengan kebutuhan acara.</h2>
    </div>
    <div class="package-grid">
      {packages.map((paket) => (
        <article class={paket.featured ? "package-card featured" : "package-card"}>
          <p class="eyebrow">{paket.featured ? "Favorit" : "Paket"}</p>
          <h3>{paket.title}</h3>
          <strong>{paket.price}</strong>
          <p>{paket.description}</p>
          <a href={`/${paket.slug}`}>Lihat detail</a>
        </article>
      ))}
    </div>
  </section>

  <section class="section section-muted">
    <div class="section-heading">
      <p class="eyebrow">Portofolio</p>
      <h2>Momen yang sudah kami bantu wujudkan.</h2>
    </div>
    <div class="card-grid">
      {portfolios.map((item) => <CardPortofolio item={item} />)}
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <p class="eyebrow">Testimoni</p>
      <h2>Kata pasangan yang pernah bekerja bersama kami.</h2>
    </div>
    <div class="testimonial-grid">
      {testimonials.map((item) => (
        <figure class="testimonial-card">
          <blockquote>{item.quote}</blockquote>
          <figcaption>{item.title}</figcaption>
        </figure>
      ))}
    </div>
  </section>
</BaseLayout>
