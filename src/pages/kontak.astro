---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Kontak | EO Wedding Astro">
  <section class="min-h-[42vh] bg-[#edf1e2] px-[clamp(20px,5vw,72px)] py-[clamp(64px,10vw,118px)]">
    <p class="mb-2.5 text-xs font-extrabold uppercase text-coral">Kontak</p>
    <h1 class="mb-[22px] max-w-[920px] text-[clamp(2.25rem,6vw,5.8rem)] leading-[0.98]">Mari mulai dari tanggal acara dan kebutuhan utama.</h1>
    <p class="max-w-[720px] text-[clamp(1rem,1.8vw,1.24rem)] leading-[1.7]">Kirim detail rencana pernikahan agar tim kami bisa menyiapkan rekomendasi paket dan estimasi awal.</p>
  </section>

  <section class="grid grid-cols-1 gap-[42px] px-[clamp(20px,5vw,72px)] py-[clamp(52px,8vw,96px)] min-[860px]:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
    <div>
      <h2 class="mb-4 text-[clamp(1.8rem,3.4vw,3.4rem)] leading-[1.08]">Hubungi tim kami</h2>
      <p class="leading-[1.7] text-muted">WhatsApp: <a class="font-bold text-coral" href="https://wa.me/6281234567890">+62 812-3456-7890</a></p>
      <p class="leading-[1.7] text-muted">Email: <a class="font-bold text-coral" href="mailto:hello@eowedding.local">hello@eowedding.local</a></p>
      <p class="leading-[1.7] text-muted">Area layanan: Jabodetabek dan kota lain sesuai kebutuhan.</p>
    </div>
    <form class="grid gap-4 rounded-lg border border-forest/10 bg-white p-6 shadow-soft" name="kontak" method="post" data-netlify="true">
      <input type="hidden" name="form-name" value="kontak" />
      <label class="grid gap-2 font-extrabold text-forest">
        Nama
        <input class="w-full rounded-lg border border-forest/20 px-3.5 py-3 font-[inherit]" type="text" name="nama" required />
      </label>
      <label class="grid gap-2 font-extrabold text-forest">
        Email
        <input class="w-full rounded-lg border border-forest/20 px-3.5 py-3 font-[inherit]" type="email" name="email" required />
      </label>
      <label class="grid gap-2 font-extrabold text-forest">
        Pesan
        <textarea class="w-full rounded-lg border border-forest/20 px-3.5 py-3 font-[inherit]" name="pesan" rows="5" required></textarea>
      </label>
      <button class="inline-flex min-h-[46px] items-center justify-center rounded-lg border border-transparent bg-coral px-[18px] py-[13px] font-extrabold text-bg" type="submit">Kirim</button>
    </form>
  </section>
</BaseLayout>
