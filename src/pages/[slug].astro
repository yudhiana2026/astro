---
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import BaseLayout from "../layouts/BaseLayout.astro";

type DetailFrontmatter = {
  title: string;
  date?: string;
  location?: string;
  category?: string;
  cover?: string;
  excerpt?: string;
  image?: string;
  rating?: number;
  quote?: string;
  price?: string;
  featured?: boolean;
  description?: string;
  features?: string[];
};

type MarkdownModule = {
  frontmatter: DetailFrontmatter;
  Content: AstroComponentFactory;
};

type DetailEntry = {
  slug: string;
  collection: string;
  frontmatter: DetailFrontmatter;
  Content: AstroComponentFactory;
};

export function getStaticPaths() {
  const modules = {
    ...import.meta.glob<MarkdownModule>("../content/portofolio/*.md", { eager: true }),
    ...import.meta.glob<MarkdownModule>("../content/paket/*.md", { eager: true }),
    ...import.meta.glob<MarkdownModule>("../content/testimoni/*.md", { eager: true }),
  };

  const entries = Object.entries(modules).map(([path, module]) => {
    const parts = path.split("/");
    const filename = parts.pop() ?? "";
    return {
      slug: filename.replace(".md", ""),
      collection: parts.pop() ?? "",
      frontmatter: module.frontmatter,
      Content: module.Content,
    };
  });

  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: DetailEntry };
const { frontmatter } = entry;
const Content = entry.Content;
---

<BaseLayout title={`${frontmatter.title} | EO Wedding Astro`}>
  <article class="grid">
    {frontmatter.cover && <img class="aspect-[16/7] w-full object-cover" src={frontmatter.cover} alt={`Foto ${frontmatter.title}`} />}
    {frontmatter.image && <img class="aspect-[16/7] w-full object-cover" src={frontmatter.image} alt={`Foto ${frontmatter.title}`} />}
    <div class="mx-auto w-full max-w-[860px] px-5 py-[clamp(42px,7vw,84px)]">
      <p class="mb-2.5 text-xs font-extrabold uppercase text-coral">{entry.collection}</p>
      <h1 class="mb-[18px] text-[clamp(2rem,5vw,4.2rem)] leading-[1.04]">{frontmatter.title}</h1>
      {frontmatter.location && <p class="text-[1.2rem] font-extrabold text-forest">{frontmatter.location}</p>}
      {frontmatter.price && <p class="text-[1.2rem] font-extrabold text-forest">{frontmatter.price}</p>}
      {frontmatter.excerpt && <p class="leading-[1.7] text-muted">{frontmatter.excerpt}</p>}
      {frontmatter.description && <p class="leading-[1.7] text-muted">{frontmatter.description}</p>}
      {frontmatter.features && (
        <ul class="my-6 grid gap-2.5 pl-5 text-muted">
          {frontmatter.features.map((feature: string) => <li>{feature}</li>)}
        </ul>
      )}
      <div class="mt-6 space-y-4 leading-[1.7] text-muted">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>
