---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Tentang | EO Wedding Astro">
  <section class="page-hero compact">
    <p class="eyebrow">Tentang Kami</p>
    <h1>Partner pernikahan yang menjaga detail tetap tertata.</h1>
    <p>
      EO Wedding Astro membantu pasangan dan keluarga merancang acara yang indah,
      realistis, dan lancar dari persiapan sampai hari-H.
    </p>
  </section>

  <section class="section two-column">
    <div>
      <h2>Cara kami bekerja</h2>
      <p>
        Kami memulai dari kebutuhan pasangan, kapasitas tamu, gaya acara, prioritas
        keluarga, dan anggaran. Dari sana kami menyusun konsep, timeline, kebutuhan
        vendor, dan koordinasi teknis.
      </p>
    </div>
    <div class="value-list">
      <article>
        <h3>Terstruktur</h3>
        <p>Rundown, vendor, dan kebutuhan teknis ditata sejak awal.</p>
      </article>
      <article>
        <h3>Personal</h3>
        <p>Konsep acara disesuaikan dengan karakter pasangan.</p>
      </article>
      <article>
        <h3>Tenang</h3>
        <p>Tim lapangan menjaga alur acara agar keluarga bisa menikmati momen.</p>
      </article>
    </div>
  </section>
</BaseLayout>
